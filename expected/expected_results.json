            "record_ids": ["PR-5003", "PR-5004", "PR-5005", "PR-5009"],
            "source_lines": ["production_records.csv:4", "production_records.csv:5", "production_records.csv:6", "production_records.csv:7"],
            "alternatives": { "exclude_suspected": {
              "input_kg": "1000", "good_kg": "900", "scrap_kg": "100", "scrap_rate_pct": "10" } }
          },
          "issues": ["SUSPECTED_DUPLICATE_RECORD:error"],
