      "20_duplicate_file_upload": {
        "extends": "00_baseline",
        "import_checks": {
          "duplicate_of": "00_baseline",
          "second_upload_result": "duplicate_file",
          "note": "Folder content is byte-identical to 00_baseline. Uploading it again must be detected by content hash (DUPLICATE_FILE, warning) and must not add a second set of rows."
        }
