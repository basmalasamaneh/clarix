{
  "_meta": {
    "purpose": "Golden set. Hand-written expected outputs for every test dataset. The app's calculation engine must reproduce these values exactly.",
    "conventions": {
      "numbers": "Strings holding exact decimals ('10', '7.5', '-2'). Compare as decimals, never as floats. null = not available / not computable (never 0).",
      "status": "green | yellow | red per metric group (volume, changeover, downtime). 'overall' = worst of the three.",
      "comparison": "value = run B minus run A. comparable=false when either side is null or either group is red.",
      "source_lines": "'<file>:<physical line number>' with the header row as line 1. These are the lineage links behind each number.",
      "excluded_source_lines": "Rows left out of the totals but kept visible: identical duplicates and events with an unmapped code.",
      "quarantined_source_lines": "Rows that are unusable (missing id, invalid time range, conflicting duplicates). They make the affected group's value N/A.",
      "extends": "A scenario inherits everything from the named scenario and overrides only what it lists (objects merge, arrays and scalars replace)."
    }
  },
  "datasets": {
    "ethmar-plastics": {
      "00_baseline": {
        "description": "The clean case from the brief.",
        "capability_level": 3,
        "runs": {
          "E-01": {
            "volume": {
              "status": "green",
              "input_kg": "1000", "good_kg": "950", "scrap_kg": "50",
              "scrap_rate_pct": "5", "good_rate_pct": "95", "material_balance_kg": "0",
              "record_ids": ["PR-5001", "PR-5002"],
              "source_lines": ["production_records.csv:2", "production_records.csv:3"],
              "excluded_source_lines": [], "quarantined_source_lines": [], "alternatives": {}
            },
            "changeover": {
              "status": "green", "minutes": "240",
              "event_ids": ["EV-1001"], "source_lines": ["events.csv:2"],
              "excluded_source_lines": [], "quarantined_source_lines": [], "alternatives": {}
            },
            "downtime": {
              "status": "green", "minutes": "0", "event_count": 0,
              "event_ids": [], "source_lines": [],
              "excluded_source_lines": [], "quarantined_source_lines": [], "alternatives": {}
            },
            "overlaps": [],
            "issues": [],
            "overall": "green"
          },
          "E-02": {
            "volume": {
              "status": "green",
              "input_kg": "1000", "good_kg": "900", "scrap_kg": "100",
              "scrap_rate_pct": "10", "good_rate_pct": "90", "material_balance_kg": "0",
              "record_ids": ["PR-5003", "PR-5004", "PR-5005"],
              "source_lines": ["production_records.csv:4", "production_records.csv:5", "production_records.csv:6"],
              "excluded_source_lines": [], "quarantined_source_lines": [], "alternatives": {}
            },
            "changeover": {
              "status": "green", "minutes": "360",
              "event_ids": ["EV-2001"], "source_lines": ["events.csv:3"],
              "excluded_source_lines": [], "quarantined_source_lines": [], "alternatives": {}
            },
            "downtime": {
              "status": "green", "minutes": "45", "event_count": 1,
              "event_ids": ["EV-2002"], "source_lines": ["events.csv:4"],
              "excluded_source_lines": [], "quarantined_source_lines": [], "alternatives": {}
            },
            "overlaps": [],
            "issues": [],
            "overall": "green"
          }
        },
        "comparison": {
          "pair": ["E-01", "E-02"],
          "metrics": {
            "scrap_rate_pp": { "value": "5", "comparable": true },
            "good_rate_pp": { "value": "-5", "comparable": true },
            "changeover_min": { "value": "120", "comparable": true },
            "downtime_min": { "value": "45", "comparable": true }
          }
        },
        "file_issues": [],
        "formula_like_cells": []
      },

      "01_duplicate_event_same_id": {
        "extends": "00_baseline",
        "runs": { "E-02": {
          "downtime": { "status": "yellow", "excluded_source_lines": ["events.csv:5"] },
          "issues": ["DUPLICATE_EVENT_ID_IDENTICAL:warning"],
          "overall": "yellow"
        } }
      },

      "02_suspected_duplicate_event": {
        "extends": "00_baseline",
        "runs": { "E-02": {
          "downtime": {
            "status": "yellow", "minutes": "90", "event_count": 2,
            "event_ids": ["EV-2002", "EV-2003"],
            "source_lines": ["events.csv:4", "events.csv:5"],
            "alternatives": { "minutes_if_suspected_excluded": "45" }
          },
          "issues": ["SUSPECTED_DUPLICATE_EVENT:warning"],
          "overall": "yellow"
        } },
        "comparison": { "metrics": { "downtime_min": { "value": "90", "comparable": true } } }
      },

      "03_conflicting_duplicate_event_id": {
        "extends": "00_baseline",
        "runs": { "E-02": {
          "downtime": {
            "status": "red", "minutes": null, "event_count": 0,
            "event_ids": [], "source_lines": [],
            "quarantined_source_lines": ["events.csv:4", "events.csv:5"]
          },
          "issues": ["DUPLICATE_EVENT_ID_CONFLICT:error"],
          "overall": "red"
        } },
        "comparison": { "metrics": { "downtime_min": { "value": null, "comparable": false } } }
      },

      "04_duplicate_record_identical": {
