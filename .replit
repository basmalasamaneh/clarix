modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.development]
SEED_TEST_USERS = "true"
AI_BREAKER_FAILURES = "3"
AI_BREAKER_SECONDS = "60"
AI_CACHE_SECONDS = "300"
AI_DAILY_CAP = "50"
AI_TIMEOUT_MS = "12000"
AI_USER_PER_MINUTE = "3"
GEMINI_MODEL = "gemini-3.8-flash"

[userenv.production]
CLARIX_INITIAL_ROLE = "platform_admin"
GEMINI_MODEL = "gemini-3.8-flash"
NODE_ENV = "production"
SEED_TEST_USERS = "false"
CLARIX_INITIAL_ADMIN_EMAIL = "basmalasamaneh@gmail.com"
